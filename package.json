{
  "name": "slopdock-design-system",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "slopdock design system: shadcn registry (copy-in) + Storybook.",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "registry": "node scripts/build-registry.ts && shadcn build -o public/r",
    "storybook": "pnpm registry && storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "build-storybook": "pnpm registry && storybook build -o storybook-static",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.65.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
